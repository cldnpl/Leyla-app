<?xml version="1.0" encoding="utf-8"?>
<!-- The icon's pink, with the soft glow behind the L, sampled from the artwork:
     #FFB1B6 at the centre falling to #FF8C91 at the corners. Kept as a shape
     rather than a bitmap so it stays crisp at every launcher size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="60%p"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#FFB1B6"
        android:endColor="#FF8C91" />
</shape>
