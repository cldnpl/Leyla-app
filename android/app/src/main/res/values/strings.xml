    <string name="trimester_first">First trimester</string>
    <string name="trimester_second">Second trimester</string>
    <string name="trimester_third">Third trimester</string>
    <string name="trimester_about_first">The baby\'s major organs are forming. She may feel nausea, deep fatigue, and tender breasts — even though there\'s little to see yet.</string>
    <string name="trimester_about_second">Often the easiest stretch: energy returns and the bump grows. She may feel the baby move for the first time.</string>
    <string name="trimester_about_third">The baby grows fast and settles into position. Sleep gets harder, with possible swelling, backache, and practice contractions.</string>
    <string name="trimester_support_first_1">Be patient with nausea and fatigue</string>
    <string name="trimester_support_first_2">Handle cooking smells she can\'t stand</string>
    <string name="trimester_support_first_3">Let her nap and rest without guilt</string>
    <string name="trimester_support_first_4">Go with her to the first scans</string>
    <string name="trimester_support_second_1">Plan nice outings while she has energy</string>
    <string name="trimester_support_second_2">Start prepping the nursery together</string>
    <string name="trimester_support_second_3">Talk and sing to the bump</string>
    <string name="trimester_support_second_4">Help with back or hip aches</string>
    <string name="trimester_support_third_1">Get her comfortable — pillows, foot rubs</string>
    <string name="trimester_support_third_2">Take over the heavy lifting and chores</string>
    <string name="trimester_support_third_3">Pack the hospital bag together</string>
    <string name="trimester_support_third_4">Know the plan for the big day</string>

