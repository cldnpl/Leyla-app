<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+). The launcher masks these to whatever shape the
     device uses, and only the middle 72 of 108dp is guaranteed to survive — the
     L's swash runs edge to edge in the source artwork, so the foreground holds
     it scaled into that safe area rather than full bleed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
