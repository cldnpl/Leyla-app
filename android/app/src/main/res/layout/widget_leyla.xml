<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately plain: RemoteViews supports only a handful of layouts, and a
     widget is redrawn by the launcher, not by us. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_heart"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="7dp"
        android:background="@drawable/widget_heart_background"
        android:src="@drawable/ic_widget_heart"
        android:contentDescription="@string/widget_miss_you_action" />

    <TextView
        android:id="@+id/widget_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText"
        android:text="—" />

    <TextView
        android:id="@+id/widget_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        android:text="@string/widget_days_together" />

    <TextView
        android:id="@+id/widget_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:text="@string/widget_no_distance" />

    <TextView
        android:id="@+id/widget_partner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:text="@string/app_name" />
</LinearLayout>
